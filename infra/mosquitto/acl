# Device account, shared by the ESP32 and the Python simulator.
# The simulator stays on sentinelx/g6. The board uses sentinelx/esp32-01.
user esp01
topic write sentinelx/g6/telemetry
topic write sentinelx/g6/alerts
topic write sentinelx/g6/status
topic read sentinelx/g6/cmd
topic write sentinelx/esp32-01/telemetry
topic write sentinelx/esp32-01/alerts
topic write sentinelx/esp32-01/status
topic write sentinelx/esp32-01/ack
topic read sentinelx/esp32-01/cmd

# API: ingest device traffic, publish commands. No publish on telemetry.
user api
topic read sentinelx/g6/telemetry
topic read sentinelx/g6/alerts
topic read sentinelx/g6/status
topic write sentinelx/g6/cmd
topic read sentinelx/esp32-01/telemetry
topic read sentinelx/esp32-01/alerts
topic read sentinelx/esp32-01/status
topic read sentinelx/esp32-01/ack
topic write sentinelx/esp32-01/cmd
