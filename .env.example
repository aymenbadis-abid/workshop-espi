# Copy this file to .env and replace every change-me value.
# .env is gitignored. Do not put real passwords, Wi-Fi credentials, or private keys in Git.
# The laptop IP is assigned by the phone hotspot and must never be hardcoded in source.

# Public IP of this machine on the phone hotspot. Used only by the certificate script.
SERVER_IP=192.168.0.10

# PostgreSQL
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinelx

# MQTTS (port 8883). Plain MQTT on 1883 stays off unless explicitly enabled for early debugging.
# MQTT_HOST is the Docker DNS name used by containers.
# MQTT_PUBLIC_HOST is used by tools on the host (simulator, mosquitto_pub).
MQTT_HOST=mosquitto
MQTT_PUBLIC_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_ALLOW_PLAINTEXT=false
MQTT_USERNAME=esp01
MQTT_PASSWORD=change-me
MQTT_API_USERNAME=api
MQTT_API_PASSWORD=change-me-api
MQTT_TOPIC_BASE=sentinelx/g6
# ESP32 topics. The simulator stays on MQTT_TOPIC_BASE.
MQTT_DEVICE_BASE=sentinelx/esp32-01
MQTT_CA_CERT=infra/certs/ca.crt

# API
API_PORT=8000
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# Vision runs on the host, not in Docker.
# 0 = built-in camera. A file path is the fallback when no camera is available.
VIDEO_SOURCE=0
VISION_API_URL=http://127.0.0.1:8000
VISION_PORT=8090

# Grafana, bound to localhost only.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
